# Set these in your shell; the application does not automatically load .env.
# Docker Compose host binding; use your Wi-Fi IPv4 for a local phone test.
APP_BIND_ADDRESS=127.0.0.1
HTTP_ADDR=127.0.0.1:8080
COOKIE_SECURE=false
RESOURCE_DIR=.local/resources
RESOURCE_QUOTA_BYTES=104857600
DATABASE_URL=postgres://cabv:cabv_dev_only@localhost:55433/cabv?sslmode=disable
# Optional phone identity: exact hostname/origin; HTTPS requires secure cookies.
# PUBLIC_ORIGIN=https://attendance.example.edu
# WEBAUTHN_RP_ID=attendance.example.edu
# TLS_CERT_FILE=.local/tls/server.crt
# TLS_KEY_FILE=.local/tls/server.key
# Compose local HTTPS overlay only (use your current laptop Wi-Fi IP):
# LOCAL_HTTPS_HOST=cabv.10.218.25.223.sslip.io
# HTTPS_BIND_ADDRESS=0.0.0.0
