# Render Docker web-service profile. Replace placeholders before importing.
# This file contains no real credentials. Never import .env.example into Render.
# Go does not automatically load either file.
HTTP_ADDR=0.0.0.0:10000
PORT=10000
COOKIE_SECURE=true
RESOURCE_DIR=/app/resources
RESOURCE_QUOTA_BYTES=104857600
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_INTERNAL_HOST:5432/REPLACE_DATABASE?sslmode=require
PUBLIC_ORIGIN=https://REPLACE_WITH_YOUR_SERVICE.onrender.com
WEBAUTHN_RP_ID=REPLACE_WITH_YOUR_SERVICE.onrender.com

# Render Settings:
# Docker Command: blank (use the Dockerfile CMD)
# Pre-deploy Command: cabv-migrate up
# Health Check Path: /readyz
# Optional persistent disk Mount Path: /app/resources
# Render manages public HTTPS; leave TLS_CERT_FILE and TLS_KEY_FILE unset.
